# App
APP_NAME="AI Hospital Management System"
SECRET_KEY=""
ALGORITHM=""
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# MySQL connection string: mysql+pymysql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL="mysql+pymysql://root:@localhost:3306/your_db_name"
# Groq API
GROQ_API_KEY="Write your Groq API key here"
GROQ_MODEL="openai/gpt-oss-120b"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Hospital System <your-email@gmail.com>"

# Hospital Info (used by chatbot)
HOSPITAL_NAME="City General Hospital"
HOSPITAL_PHONE="+1-800-HOSPITAL"
HOSPITAL_EMAIL="info@cityhospital.com"
HOSPITAL_ADDRESS="123 Medical Drive, Health City"
